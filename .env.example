# ── Required ────────────────────────────────────────────────────────────────
# Signs session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value

# MongoDB password (docker compose creates the database user with it).
MONGO_PASSWORD=CHANGE_ME_mongo_password

# First admin account, created on first start when no accounts exist.
# Change the password after you sign in (My account).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_at_least_10_chars

# ── Where things live ──────────────────────────────────────────────────────
# Server files (configs, profiles, mods). Needs room: each server is 15-25 GB.
SERVER_DATA_ROOT=/srv/garrison/servers
# Port the panel listens on.
PORT=8000

# ── Behind a reverse proxy ──────────────────────────────────────────────────
# Public URL of the panel, used in links.
SITE_URL=
# "auto" marks the session cookie Secure when the request came over HTTPS.
COOKIE_SECURE=auto
# Set true ONLY when a reverse proxy you run sits in front, so rate limits see
# the real client address from X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Bind to 127.0.0.1 instead when a reverse proxy on this host is the only way in.
HOST=0.0.0.0

# ── Game servers ───────────────────────────────────────────────────────────
SERVER_DOCKER_IMAGE=ghcr.io/acemod/arma-reforger:latest
MAX_SERVER_INSTANCES=8
# Each new server takes the next free block of ports from these bases.
SERVER_PORT_BASE_GAME=2001
SERVER_PORT_BASE_QUERY=17777
SERVER_PORT_BASE_RCON=19999
SERVER_PORT_BLOCK_SIZE=10

# ── Optional AI helpers (file assist, crash fix suggestions, log triage) ──
# Leave both empty to turn them off.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional log collector ─────────────────────────────────────────────────
# External collectors may POST log lines to /api/log with this key.
LOG_COLLECTOR_API_KEY=
